# URL del proyecto Supabase (Settings > API)
SUPABASE_URL=https://wpdgscvpaelpzgruxntq.supabase.co

# Service Role Key: SOLO se usa en backend. Tiene permisos totales sobre
# la base de datos y salta cualquier Row Level Security. NUNCA debe
# llegar al frontend ni subirse a un repositorio público.
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# Puerto del servidor Apollo
PORT=4000
